{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "meta": {
    "brand": "ChambaYa",
    "system": "Sistema Multiplataforma de Trabajos Temporales",
    "version": "1.0.0",
    "reference": "SRS v1.4 / Arq v2"
  },
  "colors": {
    "primary": {
      "50": "#EFF6FF",
      "100": "#DBEAFE",
      "500": "#3B82F6",
      "600": "#2563EB",
      "700": "#1D4ED8",
      "900": "#1E3A8A"
    },
    "secondary": {
      "50": "#F0FDFA",
      "100": "#CCFBF1",
      "600": "#0D9488",
      "700": "#0F766E"
    },
    "surface": {
      "background": "#F8FAFC",
      "card": "#FFFFFF",
      "subtle": "#F1F5F9",
      "border": "#E2E8F0",
      "borderStrong": "#CBD5E1"
    },
    "text": {
      "primary": "#0F172A",
      "secondary": "#475569",
      "muted": "#64748B",
      "inverted": "#FFFFFF"
    },
    "semantic": {
      "success": {
        "bg": "#DCFCE7",
        "text": "#15803D",
        "border": "#86EFAC",
        "dot": "#22C55E"
      },
      "warning": {
        "bg": "#FEF3C7",
        "text": "#B45309",
        "border": "#FCD34D",
        "dot": "#F59E0B"
      },
      "error": {
        "bg": "#FEE2E2",
        "text": "#B91C1C",
        "border": "#FCA5A5",
        "dot": "#EF4444"
      },
      "info": {
        "bg": "#DBEAFE",
        "text": "#1D4ED8",
        "border": "#93C5FD",
        "dot": "#3B82F6"
      },
      "neutral": {
        "bg": "#F1F5F9",
        "text": "#334155",
        "border": "#CBD5E1",
        "dot": "#94A3B8"
      },
      "purple": {
        "bg": "#EDE9FE",
        "text": "#6D28D9",
        "border": "#C4B5FD",
        "dot": "#8B5CF6"
      }
    }
  },
  "typography": {
    "fontFamily": {
      "sans": "Inter",
      "mono": "JetBrains Mono"
    },
    "scale": {
      "display": {
        "fontFamily": "Inter",
        "fontSize": 24,
        "lineHeight": 30,
        "fontWeight": "700",
        "letterSpacing": -0.4
      },
      "h1": {
        "fontFamily": "Inter",
        "fontSize": 20,
        "lineHeight": 26,
        "fontWeight": "700",
        "letterSpacing": -0.3
      },
      "h2": {
        "fontFamily": "Inter",
        "fontSize": 16,
        "lineHeight": 22,
        "fontWeight": "600",
        "letterSpacing": 0
      },
      "h3": {
        "fontFamily": "Inter",
        "fontSize": 14,
        "lineHeight": 20,
        "fontWeight": "600",
        "letterSpacing": 0
      },
      "body": {
        "fontFamily": "Inter",
        "fontSize": 13,
        "lineHeight": 19,
        "fontWeight": "400",
        "letterSpacing": 0
      },
      "caption": {
        "fontFamily": "Inter",
        "fontSize": 11,
        "lineHeight": 15,
        "fontWeight": "400",
        "letterSpacing": 0
      },
      "label": {
        "fontFamily": "Inter",
        "fontSize": 11,
        "lineHeight": 14,
        "fontWeight": "600",
        "letterSpacing": 0.6,
        "textTransform": "uppercase"
      },
      "mono": {
        "fontFamily": "JetBrains Mono",
        "fontSize": 15,
        "lineHeight": 20,
        "fontWeight": "700",
        "letterSpacing": 0
      }
    }
  },
  "spacing": {
    "1": 4,
    "2": 8,
    "3": 12,
    "4": 16,
    "5": 20,
    "6": 24,
    "8": 32,
    "12": 48
  },
  "radii": {
    "sm": 6,
    "md": 10,
    "lg": 16,
    "full": 9999
  },
  "shadows": {
    "1": {
      "web": "0 1px 2px 0 rgba(15, 23, 42, 0.06), 0 1px 3px 0 rgba(15, 23, 42, 0.04)",
      "native": {
        "shadowColor": "#0F172A",
        "shadowOffset": { "width": 0, "height": 1 },
        "shadowOpacity": 0.06,
        "shadowRadius": 3,
        "elevation": 1
      }
    },
    "2": {
      "web": "0 4px 12px -2px rgba(15, 23, 42, 0.10), 0 2px 4px -2px rgba(15, 23, 42, 0.06)",
      "native": {
        "shadowColor": "#0F172A",
        "shadowOffset": { "width": 0, "height": 4 },
        "shadowOpacity": 0.1,
        "shadowRadius": 8,
        "elevation": 4
      }
    },
    "3": {
      "web": "0 16px 32px -4px rgba(15, 23, 42, 0.18), 0 6px 12px -4px rgba(15, 23, 42, 0.08)",
      "native": {
        "shadowColor": "#0F172A",
        "shadowOffset": { "width": 0, "height": 10 },
        "shadowOpacity": 0.18,
        "shadowRadius": 18,
        "elevation": 10
      }
    }
  }
}
